__children["RenderSettings"]["resolution_expression"]["__expression"].setValue( '\nrender_resolution = context.get("ayon:resolution")\nparent["__out"]["p2"] = render_resolution\nuse_custom_resolution = parent["__in"]["p2"]\n\ncustom_resolution = parent["__in"]["p0"]\nresolution_multiplier = parent["__in"]["p1"]\n\nif use_custom_resolution:\n   used_resolution = custom_resolution\nelse:\n   used_resolution = render_resolution\n   \n   \neffective_resolution = imath.V2i(used_resolution[0] * resolution_multiplier, used_resolution[1] * resolution_multiplier)\n\nparent["__out"]["p1"] = effective_resolution\n\nparent["__out"]["p0"] = used_resolution' )


