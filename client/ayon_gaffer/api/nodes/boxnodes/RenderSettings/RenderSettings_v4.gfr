Gaffer.Metadata.registerValue( __children["RenderSettings"]["options_lightSamples"]["enabled"], 'spreadsheet:columnName', 'lightSamplesEnabled' )
Gaffer.Metadata.registerValue( __children["RenderSettings"]["options_textureUseExistingTx"], 'spreadsheet:columnName', 'textureUseExistingTx' )
